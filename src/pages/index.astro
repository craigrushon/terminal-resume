---
import { isExampleContent, resume } from '../lib/resume/source';
import { Terminal } from '../components/Terminal';
import '../styles/tokens.css';
import '../styles/terminal.css';

const { basics } = resume;
const title = `${basics.name}: ${basics.label}`;
---
<!doctype html>
<html lang="en" data-theme="modern">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={basics.summary} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    {isExampleContent && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <main>
      <h1>{basics.name}</h1>
      <p class="label">{basics.label}</p>
      <p>{basics.summary}</p>
    </main>
    <Terminal client:idle resume={resume} />
    <noscript>
      <p class="muted">The interactive terminal needs JavaScript. A plain resume view is coming in milestone 4.</p>
    </noscript>
  </body>
</html>
