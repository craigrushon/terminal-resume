---
import { isExampleContent, resume } from '../lib/resume/source';
import { Terminal } from '../components/Terminal';
import '../styles/tokens.css';
import '../styles/terminal.css';

const { basics } = resume;
const title = `${basics.name}: ${basics.label}`;
---
<!doctype html>
<html lang="en" data-theme="modern">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={basics.summary} />
    <link rel="canonical" href={new URL('/', Astro.site)} />
    {isExampleContent && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <header class="site-header">
      <h1>{basics.name}</h1>
      <p class="label">{basics.label}</p>
    </header>
    <main>
      <Terminal client:idle resume={resume} />
      <noscript>
        <p>{basics.summary}</p>
        <p class="muted">The interactive terminal needs JavaScript. You can also find me here:</p>
        <ul>
          {basics.profiles.map((profile) => (
            <li><a href={profile.url} rel="noopener noreferrer">{profile.network}</a></li>
          ))}
        </ul>
      </noscript>
    </main>
  </body>
</html>
