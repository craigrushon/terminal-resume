---
import type { Resume } from '../lib/resume/schema';
import { buildResumeView } from '../lib/resume/view';

interface Props {
  resume: Resume;
}

const view = buildResumeView(Astro.props.resume);
---
<article class="resume">
  <header>
    <p class="resume-meta">{view.location}</p>
    <p class:list={[view.summaryVerbose && 'concise-only']}>{view.summary}</p>
    {view.summaryVerbose && <p class="verbose-only">{view.summaryVerbose}</p>}
  </header>

  <section aria-labelledby="resume-experience">
    <h2 id="resume-experience">Experience</h2>
    {view.work.map((job) => (
      <div class="entry">
        <h3>{job.position}, {job.company}</h3>
        <p class="resume-meta">{job.dates}</p>
        <p>{job.summary}</p>
        {job.highlights.length > 0 && <ul>{job.highlights.map((item) => <li>{item}</li>)}</ul>}
        {job.more.length > 0 && <ul class="verbose-only">{job.more.map((item) => <li>{item}</li>)}</ul>}
        {job.stack.length > 0 && <p class="resume-meta">Stack: {job.stack.join(', ')}</p>}
      </div>
    ))}
  </section>

  <section aria-labelledby="resume-projects">
    <h2 id="resume-projects">Projects</h2>
    {view.projects.map((project) => (
      <div class="entry">
        <h3>{project.name}</h3>
        <p class:list={[project.descriptionVerbose && 'concise-only']}>{project.description}</p>
        {project.descriptionVerbose && <p class="verbose-only">{project.descriptionVerbose}</p>}
        {project.highlights.length > 0 && <ul>{project.highlights.map((item) => <li>{item}</li>)}</ul>}
        {project.stack.length > 0 && <p class="resume-meta">Stack: {project.stack.join(', ')}</p>}
        {project.link && <p><a href={project.link.href} rel="noopener noreferrer">{project.link.label}</a></p>}
      </div>
    ))}
  </section>

  <section aria-labelledby="resume-skills">
    <h2 id="resume-skills">Skills</h2>
    <dl>
      {view.skills.map((skill) => (
        <>
          <dt>{skill.name}</dt>
          <dd>{skill.keywords.join(', ')}</dd>
        </>
      ))}
    </dl>
  </section>

  <section aria-labelledby="resume-education">
    <h2 id="resume-education">Education</h2>
    {view.education.map((entry) => (
      <div class="entry">
        <h3>{entry.title}</h3>
        <p>{entry.institution}</p>
        {entry.dates && <p class="resume-meta">{entry.dates}</p>}
      </div>
    ))}
  </section>

  <section aria-labelledby="resume-contact">
    <h2 id="resume-contact">Contact</h2>
    <ul>
      {view.contact.map((item) => (
        <li><a href={item.href} rel="noopener noreferrer">{item.label}</a></li>
      ))}
    </ul>
  </section>
</article>
